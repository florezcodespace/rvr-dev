# Cadena de conexión de PostgreSQL.
# Neon:     postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/rvr?sslmode=require
# Supabase: postgresql://postgres:clave@db.xxxx.supabase.co:5432/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/rvr
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rvr

# Clave con la que se firman los tokens de sesión. Cámbiala por una cadena
# larga y aleatoria; si se filtra, cualquiera puede fabricar una sesión.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Horas que dura la sesión antes de caducar.
SESION_HORAS=8

PORT=4000

# Origen del portal, para CORS. Varios se separan con coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Dirección pública del portal: arma el enlace del correo de recuperación
# de contraseña (HU_72, CA_72_02).
PORTAL_URL=http://localhost:5173

# Seguridad del inicio de sesión (CA_13_05, CA_72_02).
INTENTOS_MAXIMOS=3
MINUTOS_BLOQUEO=5
MINUTOS_RECUPERACION=30

# Correo saliente (opcional). Sin SMTP_HOST no se envían correos: en
# desarrollo el enlace de recuperación aparece en la pantalla y en la consola.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cuenta@gmail.com
# SMTP_PASS=clave-de-aplicacion
# SMTP_FROM=Portal RvR Tecnologías <no-responder@rvrtecnologias.com.co>

# Zona horaria de la API y de la sesión de PostgreSQL.
TZ=America/Bogota
